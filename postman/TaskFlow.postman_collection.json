                  "pm.test(\"Alanlar güncellendi\", () => {",
                  "  pm.expect(res.data.status).to.eql(\"completed\");",
                  "  pm.expect(res.data.title).to.eql(\"Postman ile güncellenen görev\");",
                  "  pm.expect(res.data.priority).to.eql(\"medium\");",
                  "});"
                ]
