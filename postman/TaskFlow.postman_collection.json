    {
      "name": "Raporlama",
      "item": [
        {
          "name": "Tamamlanan Görev Sayısı (GET /reports/completed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"count, listedeki görev sayısına eşit\", () => pm.expect(d.count).to.eql(d.tasks.length));",
                  "pm.test(\"Tüm görevler completed durumda\", () => pm.expect(d.tasks.every(t => t.status === \"completed\")).to.eql(true));",
                  "pm.test(\"Güncellenen görev tamamlananlarda\", () => {",
                  "  pm.expect(d.tasks.some(t => t.id === Number(pm.collectionVariables.get(\"taskId\")))).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/completed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "completed"
              ]
            }
          }
        },
        {
          "name": "Bekleyen Görev Sayısı (GET /reports/pending)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"count, listedeki görev sayısına eşit\", () => pm.expect(d.count).to.eql(d.tasks.length));",
                  "pm.test(\"Tüm görevler pending durumda\", () => pm.expect(d.tasks.every(t => t.status === \"pending\")).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/pending",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "pending"
              ]
            }
          }
        },
        {
          "name": "Genel Sistem Özeti (GET /reports/summary)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test(\"Durum sayıları toplamı toplam görev sayısına eşit\", () => {",
                  "  pm.expect(d.completedTasks + d.pendingTasks + d.inProgressTasks).to.eql(d.totalTasks);",
                  "});",
                  "pm.test(\"Tamamlanma oranı doğru hesaplandı\", () => {",
                  "  const expected = d.totalTasks ? Math.round(d.completedTasks / d.totalTasks * 10000) / 100 : 0;",
                  "  pm.expect(d.completionRate).to.eql(expected);",
                  "});",
                  "pm.test(\"Öncelik dağılımı mevcut\", () => pm.expect(d.byPriority).to.have.keys(\"low\", \"medium\", \"high\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "summary"
              ]
            }
          }
        }
      ]
