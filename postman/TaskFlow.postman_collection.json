    {
      "name": "Görev CRUD",
      "item": [
        {
          "name": "1. Görev Ekle (POST /tasks)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test(\"Görev oluşturuldu ve id döndü\", () => {",
                  "  pm.expect(res.success).to.eql(true);",
                  "  pm.expect(res.data.id).to.be.a(\"number\");",
                  "  pm.expect(res.data.title).to.eql(\"Postman ile oluşturulan görev\");",
                  "  pm.expect(res.data.status).to.eql(\"pending\");",
                  "});",
                  "pm.collectionVariables.set(\"taskId\", res.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman ile oluşturulan görev\",\n  \"description\": \"CRUD testi için örnek görev\",\n  \"priority\": \"high\",\n  \"assignee\": \"lale\",\n  \"project\": \"TaskFlow\",\n  \"dueDate\": \"2026-12-31\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
