        {
          "name": "3. Görevleri Listele (GET /tasks)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test(\"Görev listesi dizi olarak döndü\", () => {",
                  "  pm.expect(res.data).to.be.an(\"array\");",
                  "  pm.expect(res.count).to.eql(res.data.length);",
                  "});",
                  "pm.test(\"Yeni eklenen görev listede var\", () => {",
                  "  const id = Number(pm.collectionVariables.get(\"taskId\"));",
                  "  pm.expect(res.data.some(t => t.id === id)).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tasks",
              "host": [
