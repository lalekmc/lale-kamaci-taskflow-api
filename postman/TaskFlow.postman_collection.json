                  "pm.test(\"Status 400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Hata mesajı döndü\", () => pm.expect(pm.response.json().message).to.include(\"title\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
